<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.origin) }}">
  <link rel="stylesheet" href="/assets/site.css">

  {% if site.analytics and site.analytics.googleMeasurementId %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.googleMeasurementId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', '{{ site.analytics.googleMeasurementId }}', {
      cookie_domain: 'auto'
    });
  </script>
  {% endif %}

  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.origin) }}">
  <meta property="og:image" content="{{ site.image | absoluteUrl(site.origin) }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content="{{ site.imageAlt }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.image | absoluteUrl(site.origin) }}">
  <meta name="twitter:image:alt" content="{{ site.imageAlt }}">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "{{ site.organization }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "email": "{{ site.email }}",
    "areaServed": "CA",
    "founder": {
      "@type": "Person",
      "name": "{{ site.founder }}",
      "url": "https://jessehirsh.com/",
      "sameAs": [
        "https://jessehirsh.com/",
        "https://www.nsb.com/speakers/jesse-hirsh/",
        "https://en.wikipedia.org/wiki/Jesse_Hirsh"
      ],
      "knowsAbout": {{ site.knowsAbout | dump | safe }}
    },
    "knowsAbout": {{ site.knowsAbout | dump | safe }},
    "serviceType": [
      "AI adoption briefing",
      "AI stakeholder buy-in facilitation",
      "AI literacy workshop",
      "Open-source AI orientation",
      "AI adoption roadmap"
    ],
    "sameAs": {{ site.sameAs | dump | safe }}
  }
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {{ content | safe }}
  <script>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var trackedFields = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
      trackedFields.forEach(function (name) {
        document.querySelectorAll('input[name="' + name + '"]').forEach(function (input) {
          input.value = params.get(name) || '';
        });
      });
      document.querySelectorAll('input[name="referrer"]').forEach(function (input) {
        input.value = document.referrer || '';
      });
      document.querySelectorAll('input[name="landing_page"]').forEach(function (input) {
        input.value = window.location.href;
      });

      document.addEventListener('click', function (event) {
        var link = event.target.closest('a[href]');
        if (!link || typeof gtag !== 'function') return;

        var label = link.getAttribute('data-analytics-label') || link.textContent.trim();
        var href = link.getAttribute('href') || '';

        if (href.indexOf('#contact') === 0 || href.indexOf('mailto:') === 0) {
          gtag('event', 'select_content', {
            event_category: 'engagement',
            event_label: label,
            link_url: href,
            campaign_site: 'trust.metaviews.ca'
          });
        }
      });

      document.querySelectorAll('form[data-analytics-label]').forEach(function (form) {
        var status = form.querySelector('.form-status');
        form.addEventListener('submit', function (event) {
          if (typeof gtag === 'function') {
            gtag('event', 'generate_lead', {
              event_category: 'engagement',
              event_label: form.getAttribute('data-analytics-label'),
              campaign_site: 'trust.metaviews.ca'
            });
          }

          if (!window.fetch || form.getAttribute('method').toLowerCase() !== 'post') return;

          event.preventDefault();
          var button = form.querySelector('button[type="submit"]');
          if (button) button.disabled = true;
          if (status) status.textContent = 'Sending…';

          fetch(form.action, {
            method: 'POST',
            body: new URLSearchParams(new FormData(form)),
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/x-www-form-urlencoded'
            }
          }).then(function (response) {
            if (!response.ok) throw new Error('Submission failed');
            return response.json().catch(function () { return {}; });
          }).then(function () {
            form.reset();
            if (status) status.textContent = 'Thanks. We received your context and will follow up soon.';
          }).catch(function () {
            if (status) status.textContent = 'Something went wrong. Please email metaviews@gmail.com and include the context you entered here.';
          }).finally(function () {
            if (button) button.disabled = false;
          });
        });
      });
    }());
  </script>
</body>
</html>
