<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.origin) }}">
  <link rel="stylesheet" href="/assets/site.css">

  {% if site.analytics and (site.analytics.googleMeasurementId or site.analytics.googleAdsConversionId) %}
  {% set googleTagId = site.analytics.googleMeasurementId or site.analytics.googleAdsConversionId %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ googleTagId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    {% if site.analytics.googleMeasurementId %}
    gtag('config', '{{ site.analytics.googleMeasurementId }}', {
      cookie_domain: 'auto'
    });
    {% endif %}
    {% if site.analytics.googleAdsConversionId %}
    gtag('config', '{{ site.analytics.googleAdsConversionId }}');
    {% endif %}
  </script>
  {% endif %}

  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.origin) }}">
  <meta property="og:image" content="{{ site.image | absoluteUrl(site.origin) }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content="{{ site.imageAlt }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.image | absoluteUrl(site.origin) }}">
  <meta name="twitter:image:alt" content="{{ site.imageAlt }}">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "{{ site.organization }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "email": "{{ site.email }}",
    "areaServed": "CA",
    "founder": {
      "@type": "Person",
      "name": "{{ site.founder }}",
      "url": "https://jessehirsh.com/",
      "sameAs": [
        "https://jessehirsh.com/",
        "https://www.nsb.com/speakers/jesse-hirsh/",
        "https://en.wikipedia.org/wiki/Jesse_Hirsh"
      ],
      "knowsAbout": {{ site.knowsAbout | dump | safe }}
    },
    "knowsAbout": {{ site.knowsAbout | dump | safe }},
    "serviceType": [
      "AI adoption briefing",
      "AI stakeholder buy-in facilitation",
      "AI literacy workshop",
      "Open-source AI orientation",
      "AI adoption roadmap"
    ],
    "sameAs": {{ site.sameAs | dump | safe }}
  }
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {{ content | safe }}
  <script>
    (function () {
      var googleAdsConversionSendTo = {% if site.analytics and site.analytics.googleAdsConversionId and site.analytics.googleAdsConversionLabel %}'{{ site.analytics.googleAdsConversionId }}/{{ site.analytics.googleAdsConversionLabel }}'{% else %}''{% endif %};
      var params = new URLSearchParams(window.location.search);
      var trackedFields = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
      trackedFields.forEach(function (name) {
        document.querySelectorAll('input[name="' + name + '"]').forEach(function (input) {
          input.value = params.get(name) || '';
        });
      });
      document.querySelectorAll('input[name="referrer"]').forEach(function (input) {
        input.value = document.referrer || '';
      });
      document.querySelectorAll('input[name="landing_page"]').forEach(function (input) {
        input.value = window.location.href;
      });

      document.addEventListener('click', function (event) {
        var link = event.target.closest('a[href]');
        if (!link || typeof gtag !== 'function') return;

        var label = link.getAttribute('data-analytics-label') || link.textContent.trim();
        var href = link.getAttribute('href') || '';

        if (href.indexOf('#contact') === 0 || href.indexOf('mailto:') === 0) {
          gtag('event', 'select_content', {
            event_category: 'engagement',
            event_label: label,
            link_url: href,
            campaign_site: 'trust.metaviews.ca'
          });
        }
      });

      function formValues(form, name) {
        return Array.prototype.slice.call(form.querySelectorAll('[name="' + name + '"]')).map(function (field) {
          if ((field.type === 'checkbox' || field.type === 'radio') && !field.checked) return '';
          return (field.value || '').trim();
        }).filter(Boolean);
      }

      function formValue(form, name) {
        var values = formValues(form, name);
        return values.length ? values[0] : '';
      }

      function addLine(lines, label, value) {
        if (Array.isArray(value)) value = value.join(', ');
        if (value) lines.push(label + ': ' + value);
      }

      function buildContactMailto(form) {
        var email = form.getAttribute('data-contact-email') || 'metaviews@gmail.com';
        var organization = formValue(form, 'organization');
        var subject = 'AI trust and adoption conversation';
        if (organization) subject += ' — ' + organization;

        var lines = [
          'Hello Metaviews,',
          '',
          'I would like to start a conversation about AI trust, buy-in, and adoption capacity.',
          ''
        ];

        addLine(lines, 'Name', formValue(form, 'name'));
        addLine(lines, 'Email', formValue(form, 'email'));
        addLine(lines, 'Organization', organization);
        addLine(lines, 'Role/title', formValue(form, 'role'));
        addLine(lines, 'Who needs to be part of the conversation', formValues(form, 'audience'));
        addLine(lines, 'Support that might help', formValues(form, 'support'));
        addLine(lines, 'What we are trying to work through', formValue(form, 'prompt'));
        addLine(lines, 'What prompted this now', formValue(form, 'trigger'));
        addLine(lines, 'Preferred timing', formValue(form, 'timing'));

        lines.push('', 'Campaign context');
        addLine(lines, 'UTM source', formValue(form, 'utm_source'));
        addLine(lines, 'UTM medium', formValue(form, 'utm_medium'));
        addLine(lines, 'UTM campaign', formValue(form, 'utm_campaign'));
        addLine(lines, 'UTM content', formValue(form, 'utm_content'));
        addLine(lines, 'UTM term', formValue(form, 'utm_term'));
        addLine(lines, 'Referrer', formValue(form, 'referrer'));
        addLine(lines, 'Landing page', formValue(form, 'landing_page'));

        return 'mailto:' + email + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(lines.join('\n'));
      }

      document.querySelectorAll('form[data-contact-email]').forEach(function (form) {
        var status = form.querySelector('.form-status');
        form.addEventListener('submit', function (event) {
          event.preventDefault();

          var mailtoHref = buildContactMailto(form);
          var hasNavigated = false;
          function openEmailApp() {
            if (hasNavigated) return;
            hasNavigated = true;
            window.location.href = mailtoHref;
          }

          if (typeof gtag === 'function') {
            gtag('event', 'generate_lead', {
              event_category: 'engagement',
              event_label: form.getAttribute('data-analytics-label'),
              campaign_site: 'trust.metaviews.ca'
            });

            if (googleAdsConversionSendTo) {
              gtag('event', 'conversion', {
                send_to: googleAdsConversionSendTo,
                event_callback: openEmailApp,
                event_timeout: 1000
              });
              window.setTimeout(openEmailApp, 1200);
            } else {
              openEmailApp();
            }
          } else {
            openEmailApp();
          }

          if (status) status.textContent = 'Opening your email app. Please send the message from there. If nothing opens, email metaviews@gmail.com.';
        });
      });
    }());
  </script>
</body>
</html>
